# Entorno local
.venv/
__pycache__/
*.pyc
*.pyo
.serena/

# Binarios de Hadoop para Windows, los baja scripts/bootstrap.ps1 y no se versionan
winutils/

# Datos crudos, estados del streaming y memoria local del conector de Kafka
datos/
checkpoints/
.ivy2/
kafka/
kafka.tgz

# Salidas pesadas de cada fase, porque los CSV y los PNG sí se versionan
# y así la evidencia visible de los resultados queda en el historial
**/salidas/**/parquet/
**/salidas/**/sqlite/
**/salidas/**/checkpoints/

# Evidencias regenerables, se vuelven a armar con cada corrida del proyecto
evidencias/logs/

# Las capturas con fecha del entorno se acumulan corrida tras corrida, y solo se
# versiona la última, la que genera scripts/00_capturar_entorno.ps1
evidencias/entorno/*-*.txt

# Sistema
Thumbs.db
.DS_Store
desktop.ini
