# Entorno local
.venv/
__pycache__/
*.pyc
*.pyo

# Binarios de Hadoop para Windows, se descargan con bootstrap.ps1 y no se versionan
winutils/

# Datos crudos, estados del streaming y memoria del conector de Kafka
datos/
checkpoints/
.ivy2/
kafka/
kafka.tgz

# Salidas pesadas dentro de cada arquitectura, los CSV y los PNG sí se versionan
# porque son la evidencia visible de que el pipeline produjo resultados
*/salidas/parquet/
*/salidas/sqlite/
*/salidas/checkpoints/

# Evidencias regenerables con run_all.ps1
evidencias/logs/

# Las capturas con fecha del entorno se acumulan en cada corrida, versionamos solo la
# actual que genera 00_capturar_entorno.ps1
evidencias/entorno/*-*.txt

# Sistema
Thumbs.db
.DS_Store
desktop.ini
